{
  "buildCommand": "PORT=3000 BASE_PATH=/ pnpm --filter @workspace/infokb run build",
  "outputDirectory": "artifacts/infokb/dist/public",
  "rewrites": [
    { "source": "/api/lab-rentals/:id/access", "destination": "/api/lab-rentals/free-claim?studentLabPath=:id/access" },
    { "source": "/api/admin/lab-rentals/:id/launch-configuration", "destination": "/api/admin/lab-rentals?adminPath=lab-rentals/:id/launch-configuration" },
    { "source": "/api/admin/lab-rentals/:id", "destination": "/api/admin/lab-rentals?adminPath=lab-rentals/:id" },
    { "source": "/api/admin/labs/:id", "destination": "/api/admin/labs?adminPath=labs/:id" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
