{
  "buildCommand": "PORT=3000 BASE_PATH=/ pnpm --filter @workspace/infokb run build",
  "outputDirectory": "artifacts/infokb/dist/public",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
